<Project Sdk="Microsoft.NET.Sdk">

  <!--
    docs/DEMO-CITY3D-DESIGN.md "Code structure" — the engine-agnostic, headless-testable half of the
    City3D demo. Plain net8.0 classlib; NO Godot type anywhere (that lives in demos/City3D/Viewer, a
    later task). Consumes the single `SumoSharp` engine package from the LOCAL feed
    (demos/City3D/nuget.config pins SumoSharp* to ./local-nuget via packageSourceMapping — restore picks
    this up automatically because the project lives under demos/City3D/). One package now carries the
    whole portable engine (Core + Ingest + Replication + Viewer.Motion + Host + Pedestrians + LiveCity),
    per docs/SUMOSHARP-PACKAGING-DESIGN.md §V2. NOT added to Traffic.sln: it consumes packages, not
    project refs, so it stays out of the parity solution (repo rule).
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The one portable engine package (§V2): Core + Ingest + Replication + Viewer.Motion + Host +
         Pedestrians + LiveCity, all bundled. Replaces the seven individual SumoSharp.* references. -->
    <PackageReference Include="SumoSharp" Version="0.1.0" />
  </ItemGroup>

</Project>
