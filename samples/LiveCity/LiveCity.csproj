<Project Sdk="Microsoft.NET.Sdk">

  <!--
    LiveCity: the smallest possible consumer of SumoSharp.LiveCity: cars (Engine + Krauss) and a
    pedestrian crowd (SumoSharp.Pedestrians) sharing one net, with cars yielding to crossing pedestrians
    via a composite crowd-footprint source. Builds a small coupled scene over the committed
    scenarios/_ped/georef_min fixture and steps it, printing live car/ped counts and a coarse
    "held/near-stopped" car tally each report interval. A sample, not a package (IsPackable=false), so it
    never ships to NuGet and never affects the hermetic offline test loop.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- In a real consumer project this would instead be:
           dotnet add package SumoSharp.LiveCity
         We use a ProjectReference here because the packages are not yet published to nuget.org.
         SumoSharp.Core / SumoSharp.Ingest / SumoSharp.Pedestrians come along transitively, exactly like a
         real `dotnet add package SumoSharp.LiveCity` would pull them in. -->
    <ProjectReference Include="..\..\src\Sim.LiveCity\Sim.LiveCity.csproj" />
  </ItemGroup>

</Project>
