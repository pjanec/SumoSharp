<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PedestrianCrowd: the smallest possible consumer of SumoSharp.Pedestrians. Bakes a navmesh from a
    committed SUMO net, generates reproducible O/D demand, and steps the two-level LOD manager, printing
    the live low-power/high-power split as peds promote to full ORCA near an interest source. A sample,
    not a package (IsPackable=false), so it never ships to NuGet and never affects the hermetic offline
    test loop.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- In a real consumer project this would instead be:
           dotnet add package SumoSharp.Pedestrians
         We use a ProjectReference here because the packages are not yet published to nuget.org. -->
    <ProjectReference Include="..\..\src\Sim.Pedestrians\Sim.Pedestrians.csproj" />
  </ItemGroup>

</Project>
